                  "variable": [
                    {
                      "description": "Anti-fraud provider endpoint URL.",
                      "type": "any",
                      "value": "{{providerApiEndpoint}}",
                      "key": "providerApiEndpoint"
                    }
                  ]
                },
                "header": [
                  {
                    "disabled": false,
                    "description": "(Required) Type of the content being sent.",
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) HTTP Client Negotiation Accept Header. Indicates the types of responses the client can understand.",
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"filter\": {\n    \"type\": \"FromOrders\",\n    \"expression\": \"value > 100\",\n    \"disableSingleFire\": false\n  },\n  \"hook\": {\n    \"url\": \"https://endpoint.example/path\",\n    \"headers\": {\n      \"key\": \"value\"\n    }\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
