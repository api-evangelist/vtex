        {
          "id": "27b603de-0644-46b7-824f-e1d8911ae32c",
          "name": "VTex Create or update hook configuration",
          "request": {
            "name": "VTex Create or update hook configuration",
            "description": {
              "content": "Configures filtering rules applied to orders hook. Learn more with the [orders hook guide](https://developers.vtex.com/vtex-rest-api/docs/orders-feed#hook).\n\r\n\rThere are two types of filtering that can be used: \n\r\n\r - `FromWorkflow`: filters orders by status.\n\r\n\r - `FromOrders`: uses JSONata expressions to filter orders according to any property in the orders JSON document.\n\r\n\r This enables stores to filter delivered orders and orders in which products have been added or removed, for example.\n\r\n\rTo learn more, access the [JSONata documentation](https://docs.jsonata.org/overview.html) and test filtering JSONata expressions with our [expressions API](https://developers.vtex.com/docs/api-reference/orders-api#post-/api/orders/expressions/jsonata).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "orders",
                "hook",
                "config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Anti-fraud provider endpoint URL.",
                  "type": "any",
                  "value": "{{providerApiEndpoint}}",
                  "key": "providerApiEndpoint"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filter\": {\n    \"type\": \"<string>\",\n    \"status\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"expression\": \"<string>\",\n    \"disableSingleFire\": \"<boolean>\"\n  },\n  \"hook\": {\n    \"url\": \"<string>\",\n    \"headers\": {\n      \"key\": \"<string>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "8c20a0d1-898a-4576-aaf7-51bfe0a8f76e",
              "name": "OK",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "orders",
                    "hook",
                    "config"
                  ],
                  "host": [
                    "{{baseUrl}}"
