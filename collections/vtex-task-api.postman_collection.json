        {
          "id": "23a403ed-720d-4a51-8618-918894605fa1",
          "name": "VTex List tasks",
          "request": {
            "name": "VTex List tasks",
            "description": {
              "content": "This endpoint allows you to filter tasks. You can choose between the following filtering options: \r\n\r\n- **Assignees:** using `assignee.email` and `status`. Example: `https://{{accountName}}.{{environment}}.com.br/api/do/tasks?assignee.email={{person@email.com}}&status={{open}}`. \r\n\r\n- **Targets:** using `targetId` and `status`. Example: `https://{{accountName}}.{{environment}}.com.br/api/do/tasks?target.id={{name}}&status={{open}}`. \r\n\r\n- **Paged tasks:** using `page`, `perPage` and `status`. Example: `https://{{accountName}}.{{environment}}.com.br/api/do/tasks?page={{1}}&perPage={{10}}&status=;{{-Closed}}`. \r\n\r\n- **Context:** using `context`, `page`, `perPage` and `status`. Example: `https://{{accountName}}.{{environment}}.com.br/api/do/tasks?context={{context}}&page={{1}}&perPage={{10}}&status={{-Closed}}`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tasks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "assignee.email",
                  "value": "<string>",
                  "description": "If you wish to list tasks by assignee, insert the desired assignee's email and status."
                },
                {
                  "disabled": false,
                  "key": "target.id",
                  "value": "<string>",
                  "description": "If you wish to list tasks by target, insert the desired `targetId` and `status`."
                },
                {
                  "disabled": false,
                  "key": "context",
                  "value": "<string>",
                  "description": "If you wish to list tasks by context, insert the desired context, `page`, `perPage` and `status`."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<string>",
                  "description": "If you wish to list tasks by context, also insert the desired `page`."
                },
                {
                  "disabled": false,
                  "key": "perPage",
                  "value": "<string>",
                  "description": "If you wish to list tasks by context, also insert the desired `perPage` value."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "If you wish to list tasks by context, also insert the desired `status`."
