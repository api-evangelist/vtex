            "description": {
              "content": "This endpoint creates a new report in the format of a CSV file and sends it via email. You can generate one of the following reports: \n\n - subscriptionsWithStatus \n\n - subscriptionsScheduledBetweenDate \n\n - subscriptionsUpdatedBetweenDate \n\n - subscriptionsCreatedBetweenDate \n\n - executionsBetweenDate",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "rns",
                "pvt",
                "reports",
                ":reportName",
                "documents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
