                  "query": [],
                  "variable": [
                    {
                      "description": "Anti-fraud provider endpoint URL.",
                      "type": "any",
                      "value": "{{providerApiEndpoint}}",
                      "key": "providerApiEndpoint"
                    }
                  ]
                },
                "header": [
                  {
                    "disabled": false,
                    "description": "(Required) Type of the content being sent",
                    "key": "Content-Type",
