                  {
                    "disabled": false,
                    "description": "(Required) HTTP Client Negotiation Accept Header. Indicates the types of responses the client can understand",
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
