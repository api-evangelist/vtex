              "body": "{\n  \"filter\": {\n    \"type\": \"FromOrders\",\n    \"expression\": \"status = \\\"payment-pending\\\"\",\n    \"disableSingleFire\": false\n  },\n  \"queue\": {\n    \"visibilityTimeoutInSeconds\": 240,\n    \"messageRetentionPeriodInSeconds\": 345600\n  }\n}",
